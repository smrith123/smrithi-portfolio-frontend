# The API origin WITHOUT /api (e.g. https://smrithi-api.onrender.com). Required on Vercel: the build fails without it.
NEXT_PUBLIC_API_URL=http://localhost:5000
# Production origin for canonical URLs, the sitemap, robots.txt, structured data and social cards (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Comma-separated profile URLs confirmed to be Smrithi's own (Instagram, TikTok, YouTube...). Used only for sameAs in the structured data.
SITE_SOCIAL_PROFILES=
# Optional: the token from Google Search Console's "HTML tag" verification method (only the content="…" value).
GOOGLE_SITE_VERIFICATION=

# Shared with the backend: it calls /api/revalidate with this after every admin save, so
# the next page view shows the change. Server-only (no NEXT_PUBLIC_ prefix). Same value as
# the backend's REVALIDATE_SECRET.
REVALIDATE_SECRET=
